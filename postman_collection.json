{
  "info": {
    "_postman_id": "4b7e9d12-3a6c-4f85-b1e0-9c2d7a5f8e31",
    "name": "Event-driven Kafka",
    "description": "One request per kind of event, across the three Kafka topics. Run the stack first (docker compose up -d --build) and follow the consumers with docker compose logs -f consumer-interactions consumer-queries consumer-health. Every response says which partition the event was written to and at which offset; the consumer logs the same partition and offset when it reads it. The partitions chosen by key below are the ones murmur2 gives with 3 partitions.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Interactions: partition chosen by the producer (interactions)",
      "description": "The producer writes each kind of interaction to its own partition: 0 views, 1 clicks, 2 scrolls. The key, the user, does not choose it. Each partition has its own sequence of offsets. Scale the consumer (docker compose up -d --scale consumer-interactions=3) and each instance reads one kind.",
      "item": [
        {
          "name": "View -> partition 0",
          "request": {
            "method": "POST",
            "description": "Writes interaction.view. Expected: partition 0, and the next offset of that partition.",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": \"user-42\",\n  \"page\": \"/products/keyboard\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/interactions/views",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "interactions",
                "views"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Click -> partition 1",
          "request": {
            "method": "POST",
            "description": "Writes interaction.click. The same user as the view, but another partition: here the kind decides. Expected: partition 1.",
