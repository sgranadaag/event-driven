    {
      "name": "Database queries: partition chosen by the key (db-queries)",
      "description": "The key is the table, and Kafka hashes it to choose the partition, so every query on a table lands in the same partition and is read in the order it was sent. Queries on other tables can land in other partitions, read in parallel. Each message stores the query itself, so it can be run again from the message alone: {\"id\", \"type\": \"insert\" | \"select\" | \"delete\", \"table\", \"payload\"}. The payload is {values} for an insert, {columns, where} for a select and {where} for a delete. The response echoes the type.",
      "item": [
        {
          "name": "Insert into users -> partition 2",
          "request": {
            "method": "POST",
            "description": "Writes query.insert with key users. Stored as {\"id\": \"3f2a9e10-6f1d-4a2b-9c3e-5d7a1b2c4e8f\", \"type\": \"insert\", \"table\": \"users\", \"payload\": {\"values\": {\"name\": \"Ana\", \"email\": \"ana@example.com\"}}}. Expected: type insert, partition 2.",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"table\": \"users\",\n  \"values\": {\n    \"name\": \"Ana\",\n    \"email\": \"ana@example.com\"\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/queries/insert",
              "host": [
                "{{baseUrl}}"
              ],
