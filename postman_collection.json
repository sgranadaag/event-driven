              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": \"user-42\",\n  \"page\": \"/products/keyboard\",\n  \"element\": \"add-to-cart\"\n}",
              "options": {
