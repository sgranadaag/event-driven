                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/interactions/clicks",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "interactions",
                "clicks"
              ]
            }
          },
          "response": []
