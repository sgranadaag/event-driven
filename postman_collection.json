{
  "info": {
    "_postman_id": "8f3c2a71-5d4e-4b9a-9c61-2e7f0a1b3d55",
    "name": "Event-driven RabbitMQ",
    "description": "One request per case of the four RabbitMQ exchange types. Run the stack first (docker compose up -d --build) and follow the consumers with docker compose logs -f consumer-orders consumer-notifications-email consumer-notifications-sms. Every response carries routed: false when the exchange delivered the message to no queue.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000",
      "type": "string"
    },
    {
      "key": "orderId",
      "value": "3f2a9e10-6f1d-4a2b-9c3e-5d7a1b2c4e8f",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Orders: direct (orders.direct)",
      "description": "Routes on an exact routing key match. Only orders.create is bound, with order.create.",
      "item": [
        {
          "name": "Create order -> orders.create",
          "request": {
            "method": "POST",
            "description": "Routing key order.create. Reaches orders.create, which consumer-orders reads. With a second consumer-orders instance running, each order goes to only one of them. Expected: routed true.",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"product\": \"keyboard\",\n  \"quantity\": 2\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/orders",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "orders"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Update order -> orders.update",
          "request": {
            "method": "PUT",
            "description": "Routing key order.update. Only orders.update is bound with that exact key. Expected: routed true, orders.update.",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"product\": \"keyboard\",\n  \"quantity\": 3\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/orders/{{orderId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "orders",
                "{{orderId}}"
              ]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "Priority orders: headers (orders.headers)",
      "description": "Sets the priority and region of an existing order. Routes on the message headers; the routing key is ignored. Both queues match priority: high and region: co. orders.express needs both (x-match=all), orders.priority needs one (x-match=any).",
      "item": [
        {
          "name": "High priority, Colombia -> both queues",
          "request": {
            "method": "PUT",
            "description": "Headers priority: high and region: co. Every header matches, so the order goes to the express line and is also moved ahead. Expected: routed true, orders.express and orders.priority.",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"priority\": \"high\",\n  \"region\": \"co\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/orders/{{orderId}}/priority",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "orders",
                "{{orderId}}",
                "priority"
              ]
            }
          },
          "response": []
        },
        {
          "name": "High priority, Mexico -> orders.priority",
          "request": {
            "method": "PUT",
            "description": "Headers priority: high and region: mx. One header matches: enough for x-match=any, not for x-match=all. Expected: routed true, orders.priority only.",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"priority\": \"high\",\n  \"region\": \"mx\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/orders/{{orderId}}/priority",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "orders",
                "{{orderId}}",
                "priority"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Low priority, Colombia -> orders.priority",
          "request": {
            "method": "PUT",
            "description": "Headers priority: low and region: co. One header matches: enough for x-match=any, not for x-match=all. Expected: routed true, orders.priority only.",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"priority\": \"low\",\n  \"region\": \"co\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/orders/{{orderId}}/priority",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "orders",
                "{{orderId}}",
                "priority"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Low priority, Mexico -> no queue",
          "request": {
            "method": "PUT",
            "description": "Headers priority: low and region: mx. Nothing matches, so the order needs no special handling. Expected: routed false.",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"priority\": \"low\",\n  \"region\": \"mx\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/orders/{{orderId}}/priority",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "orders",
                "{{orderId}}",
                "priority"
              ]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "Notifications: topic (notifications.topic)",
      "description": "Routes on a routing key pattern, notification.<channel>.<event>. notifications.email is bound with notification.email.*, notifications.sms with notification.sms.* and #.urgent.",
      "item": [
        {
          "name": "Email welcome -> notifications.email",
          "request": {
            "method": "POST",
            "description": "Routing key notification.email.welcome matches notification.email.*. Handled by consumer-notifications-email. Expected: routed true, one queue.",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"channel\": \"email\",\n  \"event\": \"welcome\",\n  \"message\": \"Welcome aboard\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/notifications",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "notifications"
              ]
            }
          },
          "response": []
        },
        {
          "name": "SMS one-time code -> notifications.sms",
          "request": {
            "method": "POST",
            "description": "Routing key notification.sms.otp matches notification.sms.*. Handled by consumer-notifications-sms. Expected: routed true, one queue.",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"channel\": \"sms\",\n  \"event\": \"otp\",\n  \"message\": \"Your code is 4821\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/notifications",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "notifications"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Email urgent -> both queues",
          "request": {
            "method": "POST",
            "description": "Routing key notification.email.urgent matches notification.email.* and #.urgent, so it reaches notifications.email and notifications.sms: consumer-notifications-email and consumer-notifications-sms each get a copy. Expected: routed true, two queues.",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"channel\": \"email\",\n  \"event\": \"urgent\",\n  \"message\": \"Server down\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/notifications",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "notifications"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Push welcome -> no queue",
          "request": {
            "method": "POST",
            "description": "Routing key notification.push.welcome matches no binding: no queue exists for push. Expected: routed false.",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"channel\": \"push\",\n  \"event\": \"welcome\",\n  \"message\": \"Welcome aboard\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/notifications",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "notifications"
              ]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "Maintenance announcements: fanout (broadcast.fanout)",
      "description": "Ignores the routing key and copies the message to every bound queue: all six.",
      "item": [
        {
          "name": "Announcement -> all 6 queues",
          "request": {
            "method": "POST",
            "description": "One message, six copies: orders.create, orders.update, orders.express and orders.priority (consumer-orders), notifications.email (consumer-notifications-email) and notifications.sms (consumer-notifications-sms). Expected: routed true.",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"message\": \"Maintenance tonight at 22:00\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/announcements",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "announcements"
              ]
            }
          },
          "response": []
        }
      ]
    }
  ]
}
